{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "ci_line_01",
  "position": {
    "x": 60,
    "y": 40,
    "z": 6000,
    "height": 220,
    "width": 560,
    "tabOrder": 10000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "Sales" } },
                  "Property": "Month Name"
                }
              },
              "queryRef": "Sales.Month Name",
              "nativeQueryRef": "Month Name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "Sales" } },
                  "Property": "Customer Count"
                }
              },
              "queryRef": "Sales.Customer Count",
              "nativeQueryRef": "Customer Count"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "Sales" } },
                  "Property": "Total Sales"
                }
              },
              "queryRef": "Sales.Total Sales",
              "nativeQueryRef": "Total Sales"
            },
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "Sales" } },
                  "Property": "Member Sales %"
                }
              },
              "queryRef": "Sales.Member Sales %",
              "nativeQueryRef": "Member Sales %",
              "format": "0.0 %;-0.0 %;0.0 %"
            }
          ]
        }
      }
    },
    "objects": {},
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": { "Literal": { "Value": "Customer Acquisition Trend (month)" } }
            }
          }
        }
      ]
    }
  }
}